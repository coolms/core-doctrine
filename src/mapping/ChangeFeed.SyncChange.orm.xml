<?xml version="1.0" encoding="UTF-8"?>
<!--
    Mapping for CoolMS\Core\ChangeFeed\SyncChange.

    The `seq` column is deliberately absent, as it was under attributes: it is a
    DB-level BIGINT GENERATED ALWAYS AS IDENTITY that the ORM must never write.
    The change-feed reader projects it through DBAL instead. Adding a field for
    it here would make the ORM try to insert it.
-->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="CoolMS\Core\ChangeFeed\SyncChange" table="coolms_sync_changes">

        <indexes>
            <index name="idx_sync_changes_recorded" columns="recorded_at"/>
        </indexes>

        <id name="id" type="uuid" column="id">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="Symfony\Bridge\Doctrine\IdGenerator\UuidGenerator"/>
        </id>

        <field name="tableName" column="table_name" type="string" length="128"/>
        <field name="rowId" column="row_id" type="string" length="64"/>
        <field name="op" column="op" type="string" length="16"
               enum-type="CoolMS\Core\ChangeFeed\SyncChangeOp"/>
        <field name="recordedAt" column="recorded_at" type="datetimetz_immutable"/>

    </entity>

</doctrine-mapping>
